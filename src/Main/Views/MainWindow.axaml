<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FromSoftwareTracker.MainWindow"
        Icon="/src/Assets/Icons/favicon.ico"
        Title="FromSoftware Tracker">

    <Grid RowDefinitions="Auto, *"> 
        <!-- Tab Control for all of the supported FromSoftware games -->
        <TabControl Grid.Row="0">
            <TabItem Header="Demon Souls">
                <TextBlock Text="Demon Souls Tracker Data" Margin="10"/>
            </TabItem>
            <TabItem Header="Dark Souls">
                <TextBlock Text="Dark Souls Tracker Data" Margin="10"/>
            </TabItem>
            <TabItem Header="Dark Souls 2">
                <TextBlock Text="Dark Souls 2 Tracker Data" Margin="10"/>
            </TabItem>
            <TabItem Header="Dark Souls 3">
                <TextBlock Text="Dark Souls 3 Tracker Data" Margin="10"/>
            </TabItem>
            <TabItem Header="Bloodborne">
                <TextBlock Text="Bloodborne Tracker Data" Margin="10"/>
            </TabItem>
            <TabItem Header="Sekrio">
                <TextBlock Text="Sekiro Tracker Data" Margin="10"/>
            </TabItem>
            <TabItem Header="Elden Ring">
                <TextBlock Text="Elden Ring Tracker Data" Margin="10"/>
            </TabItem>
            <TabItem Header="Elden Ring Nightreign">
                <TextBlock Text="Elden Ring Nightreign Tracker Data" Margin="10"/>
            </TabItem>
        </TabControl>

        <!-- Button for settings menu -->
        <Button Grid.Row="0" Content="Settings" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5" Padding="10,5"/>

        <!-- Button for view switcher menu -->
        <Button Grid.Row="1" Content="View Switcher Menu" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5" Padding="10,5">
            <Button.Flyout>
                <Flyout Placement="Top">
                    <Border Padding="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8">
                        <UniformGrid Columns="3" Rows="2" Width="300">
                            <!-- These would eventually be buttons with icons -->
                            <Button Content="Bosses" HorizontalAlignment="Stretch" Margin="5"/>
                            <Button Content="Maps" HorizontalAlignment="Stretch" Margin="5"/>
                            <Button Content="NPCs" HorizontalAlignment="Stretch" Margin="5"/>
                            <Button Content="Items" HorizontalAlignment="Stretch" Margin="5"/>
                            <Button Content="Checklist" HorizontalAlignment="Stretch" Margin="5"/>
                            <Button Content="Notes" HorizontalAlignment="Stretch" Margin="5"/>
                        </UniformGrid>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Window>
